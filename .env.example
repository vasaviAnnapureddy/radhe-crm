# Copy this file to ".env" and fill in real values.
# NEVER commit ".env". It is listed in .gitignore.

# ---------- Database ----------
# Neon connection string. Get it from the Neon dashboard (see docs/NEON_SETUP.md, Phase 2).
# Shape: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ---------- App ----------
# "development" on your laptop, "production" on Render.
ENVIRONMENT=development
# Log detail: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# ---------- Auth ----------
# Long random string used to sign login tokens. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a normal login lasts, in minutes.
JWT_EXPIRE_MINUTES=480
# How long a login lasts when "Keep me signed in" is ticked, in days.
JWT_REMEMBER_DAYS=14
# true in production (cookie sent only over https), false on localhost.
COOKIE_SECURE=false
# Max wrong-password tries per IP address per minute before login is blocked for a while.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ---------- Demo admin (seeded into the database as an argon2 hash) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------- Frontend (only variables starting with VITE_ reach the browser) ----------
# Where Vite's dev proxy forwards /api calls on your laptop.
VITE_API_PROXY_TARGET=http://localhost:8000
# true shows a small "Demo access" hint under the login form. Set false for the client demo.
VITE_SHOW_DEMO_HINT=false

# ---------- Portals ----------
# One shared demo password for every employee and customer login. Leave empty to create no portal logins.
PORTAL_PASSWORD=
# Login emails for the three story characters: a home owner, a relationship manager, a sales manager.
PORTAL_CUSTOMER_EMAIL=
PORTAL_RM_EMAIL=
PORTAL_SALES_EMAIL=
